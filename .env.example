# PC-only MFDS public-data downloader configuration.
# Copy to .env only if it does not exist; never commit a real service key.
# The Flutter app and local AI models do not load this file or need an API key.
MFDS_EASY_DRUG_SERVICE_KEY=
MFDS_EASY_DRUG_API_ENDPOINT=https://apis.data.go.kr/1471000/DrbEasyDrugInfoService/getDrbEasyDrugList

# Full local snapshots (PC collector only; never bundled in the mobile app).
GETDRUG_SERVICE_KEY=
GETDRUG_ENDPOINT=https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService07
DUR_SERVICE_KEY=
DUR_ENDPOINT=https://apis.data.go.kr/1471000/DURPrdlstInfoService03

# See docs/repository_hygiene.md for local model and SDK configuration.
